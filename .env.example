# Local development only. Copy to .env and replace placeholders as needed.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-dev-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://li-copilot.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://li-copilot.vercel.app

# Production values belong in the Render environment dashboard, not in this file.
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=replace-with-a-strong-production-secret-of-at-least-50-characters
# ALLOWED_HOSTS=your-service.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# GROQ_API_KEY=replace-with-your-groq-api-key
# CORS_ALLOWED_ORIGINS=https://li-copilot.vercel.app,chrome-extension://YOUR_EXTENSION_ID
# CSRF_TRUSTED_ORIGINS=https://li-copilot.vercel.app

# Local PostgreSQL settings. Production may use DATABASE_URL instead.
DB_NAME=linkedin_copilot
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_HOST=localhost
DB_PORT=5432

# Required to use message generation locally; required by production startup.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional; required only when Google sign-in is enabled.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
